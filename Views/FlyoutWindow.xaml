<Window x:Class="TenXBar.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TenXBar.Views"
        mc:Ignorable="d"
        Title="10xbar Flyout"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Item Button Style with Fluent Hover -->
        <Style x:Key="AppTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Width" Value="82"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#323644" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#4B5563" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#242732" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Icon Button Style -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#323644"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container Card (Single Crisp Layer) -->
    <Border x:Name="MainBorder"
            Margin="0"
            CornerRadius="12"
            Background="#1C1E26"
            BorderBrush="#383D52"
            BorderThickness="1"
            Padding="12,12,12,14">

        <StackPanel MinWidth="220">
            <!-- Header Section -->
            <Grid Margin="4,0,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Folder Accent Icon / Badge -->
                <Border Grid.Column="0"
                        Width="22" Height="22"
                        CornerRadius="5"
                        Background="#2D3246"
                        Margin="0,0,8,0">
                    <Image x:Name="GroupIconImage" Width="16" Height="16" Stretch="Uniform"/>
                </Border>

                <!-- Group Title & Count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="GroupTitleText"
                               Text="10xbar Folder"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontWeight="SemiBold"
                               FontSize="13.5"
                               Foreground="#F3F4F6"/>
                    <TextBlock x:Name="ItemCountText"
                               Text=" (4)"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#8E95A5"
                               VerticalAlignment="Center"
                               Margin="2,0,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Click="CloseButton_Click"
                        ToolTip="Close (Esc)"
                        Width="22" Height="22">
                    <TextBlock Text="✕" FontSize="11" FontFamily="Segoe UI" Foreground="#9CA3AF"/>
                </Button>
            </Grid>

            <!-- Subtle Separator -->
            <Rectangle Height="1" Fill="#282C3C" Margin="2,0,2,10"/>

            <!-- Apps Grid -->
            <ItemsControl x:Name="AppsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid x:Name="ItemsGrid" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource AppTileButtonStyle}"
                                Click="AppItem_Click"
                                Tag="{Binding}"
                                ToolTip="{Binding Name}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- App Icon -->
                                <Border Width="40" Height="40" CornerRadius="6" HorizontalAlignment="Center">
                                    <Image Source="{Binding IconPath}"
                                           Width="36" Height="36"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <!-- App Name -->
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Foreground="#E5E7EB"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="74"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
